{
  "name": "@briwa.dev/sandbox",
  "version": "0.10.0",
  "description": "Interactive figure sandboxes: a fenced code block becomes a live, isolated iframe figure.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "styles",
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./dist/core/index.js",
    "./client": "./dist/client/index.js",
    "./remark": "./dist/remark/index.js",
    "./markdown": "./dist/markdown/index.js",
    "./astro": "./dist/astro/index.js",
    "./styles": "./styles/all.css",
    "./styles/figure.css": "./styles/figure.css",
    "./styles/tokens.css": "./styles/tokens.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "dev": "vite",
    "demo:build": "vite build",
    "demo:preview": "vite preview",
    "prepack": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/briwa/sandbox#readme",
  "bugs": {
    "url": "https://github.com/briwa/sandbox/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/briwa/sandbox.git"
  },
  "devDependencies": {
    "@astrojs/internal-helpers": "^0.11.0",
    "@astrojs/markdown-remark": "^7.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-vue": "^0.1.3",
    "@lezer/highlight": "^1.2.3",
    "esbuild": "^0.28.2",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "@astrojs/internal-helpers": "^0.11.0",
    "@astrojs/markdown-remark": "^7",
    "rehype-stringify": "^10",
    "remark-parse": "^11",
    "remark-rehype": "^11",
    "unified": "^11"
  },
  "peerDependenciesMeta": {
    "@astrojs/internal-helpers": {
      "optional": true
    },
    "@astrojs/markdown-remark": {
      "optional": true
    },
    "rehype-stringify": {
      "optional": true
    },
    "remark-parse": {
      "optional": true
    },
    "remark-rehype": {
      "optional": true
    },
    "unified": {
      "optional": true
    }
  }
